# Telegram
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=123456789

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Tavily (https://app.tavily.com)
TAVILY_API_KEY=

# БД и лимиты
DATABASE_PATH=/data/topic_search.db
REQUESTS_LIMIT_DEFAULT=10
TAVILY_MAX_RESULTS=10
LLM_MODELS=gemini-3-flash,gemini-3.1-flash-lite

# Vosk
VOSK_MODEL_PATH=/models/vosk-model-small-ru-0.22

# Режим работы
USE_WEBHOOK=false
HEALTHCHECK_PORT=8080
WEBHOOK_URL=
WEBHOOK_PORT=8080

LOG_LEVEL=INFO
